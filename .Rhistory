seurat_obj_list <- readRDS("07_seurat_QC/out/seurat_obj_QC.rds")
rep(0, length(seurat_obj_list))
rep(0, length(seurat_obj_list)) %>% list()
rep(0, length(seurat_obj_list)) %>% as.list()
